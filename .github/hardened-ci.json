{
  "image": "uptime-kuma-hardened",
  "version": {"key": "uptime-kuma"},
  "revision": ["uptime-kuma", "Dockerfile", "init.go", "go.mod", "keys/", "npm-overrides.json", "scripts/", "versions.json"],
  "platforms": ["linux/amd64"],
  "compose_service": "uptime-kuma",
  "probes": [
    {"label": "Uptime Kuma", "want": "version", "cmd": "docker run --rm --entrypoint /usr/bin/node \"$IMAGE\" -p 'require(\"/app/package.json\").version'", "regex": "^[0-9][0-9.]*"},
    {"label": "iputils", "want": "iputils", "cmd": "docker run --rm --entrypoint /bin/ping \"$IMAGE\" -V", "regex": "ping from iputils \\K[0-9]+"}
  ],
  "smoke": "./scripts/test.sh \"$IMAGE\""
}
